# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_CLIENT_ID: OAuth 2.0 Web client ID (Google Cloud Console > Credentials).
# Add your origin (e.g. http://localhost:3000) to "Authorized JavaScript origins".
# While left as the placeholder, Google sign-in is disabled (the app still works as a guest).
# ⚠️  NEVER add a VITE_GOOGLE_CLIENT_ID mirror — Vite bakes every VITE_* variable into the
#     production JS bundle (visible to any browser user). The server serves this value safely
#     via GET /api/auth/config; the frontend reads it from there, not from import.meta.env.
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"

# ALLOW_DEV_LOGIN: set to "true" for a mock local account (only without GOOGLE_CLIENT_ID, never in production).
ALLOW_DEV_LOGIN="false"

# SESSION_SECRET: HMAC key for session tokens. Auto-generated into data/ if unset.
SESSION_SECRET=""

# Daily AI token budgets (reset at UTC midnight).
# DEFAULT_DAILY_TOKENS: signed-in students (falls back to 500000; legacy DAILY_TOKEN_LIMIT also read).
DEFAULT_DAILY_TOKENS="500000"
GUEST_DAILY_TOKEN_LIMIT="30000"